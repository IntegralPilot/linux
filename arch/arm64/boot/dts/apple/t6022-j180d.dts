/* PCIe devices */
&port_ge00_die1 {
	bus-range = <0x01 0x09>;

	pci@0,0 {
		device_type = "pci";
		compatible = "pci11f8,4000", "pciclass,060400", "pciclass,0604";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		ranges;
		#address-cells = <3>;
		bus-range = <0x02 0x09>;

		#size-cells = <2>;

		pci@5,0 {
			device_type = "pci";
			compatible =
				"pci11f8,4000", "pciclass,060400", "pciclass,0604";
			reg = <0x22800 0x0 0x0 0x0 0x0>;
			ranges;
			#address-cells = <3>;
			bus-range = <0x08 0x08>;
			#interrupt-cells = <1>;
			interrupt-controller;
			interrupt-map =
				<0x80000 0x0 0x0 0x1 &port_ge00_die1 0x0 0x0 0x0 0x0>,
					<0x80000 0x0 0x0 0x2 &port_ge00_die1 0x0 0x0 0x0 0x1>,
					<0x80000 0x0 0x0 0x3 &port_ge00_die1 0x0 0x0 0x0 0x2>,
					<0x80100 0x0 0x0 0x1 &port_ge00_die1 0x0 0x0 0x0 0x0>,
					<0x80100 0x0 0x0 0x2 &port_ge00_die1 0x0 0x0 0x0 0x1>,
					<0x80100 0x0 0x0 0x3 &port_ge00_die1 0x0 0x0 0x0 0x2>;
			interrupt-map-mask = <0 0 0 7>;
			reset-gpios = <&pinctrl_ap 4 GPIO_ACTIVE_LOW>;
			#size-cells = <2>;
			vpcie3v3-supply = <&wlan_pwr>;

			wifi0: wifi@0,0 {
				compatible = "pci14e4,4433";
				reg = <0x80000 0x0 0x0 0x0 0x0>;
				/* To be filled by the loader */
				local-mac-address = [00 10 18 00 00 10];
				apple,antenna-sku = "XX";
				brcm,board-type = "apple,sumatra";
			};

			bluetooth0: bluetooth@0,1 {
				compatible = "pci14e4,5f71";
				reg = <0x80100 0x0 0x0 0x0 0x0>;
				/* To be filled by the loader */
				local-bd-address = [00 00 00 00 00 00];
				brcm,board-type = "apple,sumatra";
			};
		};
	};
};

&pcie_ge_die1 {
	status = "okay";
};

&pcie_ge_dart_die1 {
	status = "okay";
};

/*
 * Delete unused PCIe nodes, the Mac Pro uses slightly different PCIe
 * controllers with a single port connected to a PM40100 PCIe switch
 */
/delete-node/ &pcie0;
/delete-node/ &pcie0_dart_0;
/delete-node/ &pcie0_dart_1;
/delete-node/ &pcie0_dart_2;
/delete-node/ &pcie0_dart_3;

&nco_clkref {
	clock-frequency = <1068000000>;
};

#include "spi1-nvram.dtsi"
